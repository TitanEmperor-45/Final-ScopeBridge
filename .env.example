# Gemini AI API Key (Injected automatically by AI Studio at runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Primary App URL & Domain
APP_URL="https://ScopeBridge.ais.studio"
PRODUCTION_APP_URL="https://ais-pre-prho5hzgxphrbuhiofy4qb-872497617609.europe-west2.run.app"
DEVELOPMENT_APP_URL="https://ais-dev-prho5hzgxphrbuhiofy4qb-872497617609.europe-west2.run.app"

# 1. STRIPE_SECRET_KEY: Stripe payment processing secure key
STRIPE_SECRET_KEY=""

# 2. PAYSTACK_SECRET_KEY: Paystack African payments secure key
PAYSTACK_SECRET_KEY=""

# 3. CHANNEL_MANAGER_API_KEY: Channel manager OTA synchronization key (Channex/Boutique Sync)
CHANNEL_MANAGER_API_KEY=""

# 4. OPENWA_API_URL: OpenWA WhatsApp gateway base endpoint URL
OPENWA_API_URL="http://localhost:2785"

# 5. OPENWA_API_KEY: OpenWA secure API authentication token
OPENWA_API_KEY="dev-admin-key"

# 6. OPENWA_SESSION: Active OpenWA WhatsApp session identifier
OPENWA_SESSION="default"

# 7. API_MASTER_KEY: Master override API key for administrative gateway calls
API_MASTER_KEY=""

# 8. ALLOW_DEV_API_KEY: Enable fallback development API key ("true" / "false")
ALLOW_DEV_API_KEY="true"

# 9. BOOTSTRAP_KEY_FILE: Path to local API bootstrap key file
BOOTSTRAP_KEY_FILE="./data/.api-key"

# 10. API_KEY_PEPPER: Cryptographic hashing pepper for secure token storage
API_KEY_PEPPER=""

# 11. DATABASE_USERNAME: Backend database username for gateway services
DATABASE_USERNAME="openwa"

# 12. DATABASE_PASSWORD: Backend database secure password
DATABASE_PASSWORD=""

# 13. REDIS_USERNAME: Redis cache service username
REDIS_USERNAME=""

# 14. REDIS_PASSWORD: Redis cache service secure password
REDIS_PASSWORD=""

# 15. S3_ACCESS_KEY_ID: AWS S3 or compatible object storage access key ID
S3_ACCESS_KEY_ID=""

# 16. S3_SECRET_ACCESS_KEY: AWS S3 or compatible object storage secret access key
S3_SECRET_ACCESS_KEY=""

# 17. WEBHOOK_SECRET: HMAC signature verification secret for incoming webhooks
WEBHOOK_SECRET=""

# 18. WHATSAPP_CLOUD_API_URL: Official Meta WhatsApp Cloud API endpoint
WHATSAPP_CLOUD_API_URL="https://graph.facebook.com/v20.0"

# 19. WHATSAPP_PHONE_NUMBER_ID: Meta WhatsApp Cloud API Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=""

# 20. WHATSAPP_ACCESS_TOKEN: Meta WhatsApp Cloud API Permanent Bearer Token
WHATSAPP_ACCESS_TOKEN=""

# 21. SMTP_RELAY_WEBHOOK_URL: Enterprise SMTP relay and email notification webhook URL
SMTP_RELAY_WEBHOOK_URL=""

# Admin Alert Contacts
